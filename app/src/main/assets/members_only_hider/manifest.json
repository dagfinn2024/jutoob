{
  "manifest_version": 2,
  "name": "YouTube Members Only Hider",
  "version": "1.2",
  "description": "Hide YouTube videos marked as 'Members only' from your feed and channel pages",
  "author": "DU3RI",
  "permissions": [
    "storage"
  ],
  "browser_action": {
    "default_icon": {
      "16": "icons/favicon-16x16.png",
      "32": "icons/favicon-32x32.png",
      "48": "icons/favicon-32x32.png"
    },
    "default_title": "YouTube Members Only Hider",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://youtube.com/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/favicon-16x16.png",
    "32": "icons/favicon-32x32.png",
    "48": "icons/favicon-32x32.png",
    "192": "icons/android-chrome-192x192.png"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "web_accessible_resources": [
    "content-script.js"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{004ce273-c2cd-4f06-a6a2-74a3e0a2e224}"
    }
  }
}